,{"_id":63343,"msg_id":28062,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28062,"thread_id":966,"date":1785185457,"date_sent":1785185457,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35178,"mid":28066,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"I do now!","sub_id":3}}],"addresses":[{"_id":63351,"msg_id":28066,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63352,"msg_id":28066,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63353,"msg_id":28066,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63354,"msg_id":28066,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28066,"thread_id":966,"date":1785187080,"date_sent":1785187080,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35179,"mid":28067,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Let’s just reschedule for a talk tomorrow if that works for you. We talked to the Roofer today and he stated that the roof was according to Derek replaced 12 years ago and the Roofer said that lines up with what he was seeing. He also said the roof was in great shape other than a couple issues, but didn’t seem like it was gonna cost more than maybe $5k if that. \n\nI think as of now we are just wanting to get proof of that roofing replaced back in 2012. We try to find the permits ourselves, but I’ve been unsuccessful. As well as the House plans on the property.\n\n\nplumbers were supposed to go out today, but they are rescheduled for tomorrow morning and HVAC. We haven’t heard from but supposedly they went out today as well waiting for the update.","sub_id":3}}],"addresses":[{"_id":63355,"msg_id":28067,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63356,"msg_id":28067,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63357,"msg_id":28067,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63358,"msg_id":28067,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28067,"thread_id":966,"date":1785187380,"date_sent":1785187380,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35180,"mid":28068,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Okay, the house plans are large he said and they were just going to leave w the home. So they are not a pdf.\nLet me think about the roof thing and how else we could get proof….\nI will just ask him about HvAC people. Did pristine call Derrick direct then?\n\nLet me know what time works for you tomorrow. The earlier the better for me but I can make anytime work.","sub_id":3}}],"addresses":[{"_id":63359,"msg_id":28068,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63360,"msg_id":28068,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63361,"msg_id":28068,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63362,"msg_id":28068,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28068,"thread_id":966,"date":1785187569,"da