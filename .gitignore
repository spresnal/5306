# Python bytecode and packaging artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Local virtual environments and configuration.
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Test, coverage, and analysis caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local editor and operating-system files.
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Temporary PDF renders/previews (including custom output filenames).
/output/*_pdf_assets/
/output/.*_pdf_render.html

# Active review-runner lock; review results remain visible to Git.
/data/reviews/.runner.lock
/data/manual/.writer.lock
/output/.publish.lock
/output/generations/*/*_pdf_assets/

# Originals, curated archives, review backups/results, and final timeline exports
# are intentional project artifacts; keep data/, backups/, and output/ trackable.
