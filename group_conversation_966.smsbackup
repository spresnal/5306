oday. I started but have to go do something so will send it over later this afternoon.","sub_id":3}}],"addresses":[{"_id":63738,"msg_id":28199,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63739,"msg_id":28199,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63740,"msg_id":28199,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63741,"msg_id":28199,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28199,"thread_id":966,"date":1785514888,"date_sent":1785514888,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/Zrt3ZQyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35358,"mid":28200,"seq":0,"ct":"text\/plain","chset":106,"cid":"<text000001>","cl":"text000001.txt","text":"As of now, we're planning on an online close. We do plan to come into town to take possession on the 21st though.\n\nAs for everything else, sounds good. We'll keep an eye out for the extension.","sub_id":3}}],"addresses":[{"_id":63742,"msg_id":28200,"address":"+15748508256","type":137,"charset":106,"sub_id":3},{"_id":63743,"msg_id":28200,"address":"+17694289566","type":151,"charset":106,"sub_id":3},{"_id":63744,"msg_id":28200,"address":"+13176504377","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28200,"thread_id":966,"date":1785515838,"date_sent":0,"msg_box":2,"read":1,"ct_t":"application\/vnd.wap.multipart.related","exp":604800,"m_cls":"personal","m_type":128,"v":18,"m_size":192,"pri":129,"rr":129,"tr_id":"proto:\/HEIw=","ct_cls":135,"d_rpt":129,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"