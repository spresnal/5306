:128,"v":18,"m_size":228747,"pri":129,"rr":129,"tr_id":"proto:\/HEIw=","ct_cls":135,"d_rpt":129,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":0,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35363,"mid":28203,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"I asked him for details. Will follow up again now","sub_id":3}}],"addresses":[{"_id":63751,"msg_id":28203,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63752,"msg_id":28203,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63753,"msg_id":28203,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63754,"msg_id":28203,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28203,"thread_id":966,"date":1785518877,"date_sent":1785518877,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35364,"mid":28204,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Got the doc, thank you ","sub_id":3}}],"addresses":[{"_id":63755,"msg_id":28204,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63756,"msg_id":28204,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63757,"msg_id":28204,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63758,"msg_id":28204,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28204,"thread_id":966,"date":1785522033,"date_sent":1785522033,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/yoBeOUxloI+G8tXluKAyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35384,"mid":28220,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Hi Darcy, I checked with the Hvac company because I didn’t hear anything back from them regarding the inspection yesterday and they just emailed me and stated that when the Tech called yesterday to go out to the house, Derrick told them that they no longer are interested in the inspection and turned them away can you find out if this is true or not because we are definitely wanting that Hvac inspection.","sub_id":3}}],"addresses":[{"_id":63800,"msg_id":28220,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63801,"msg_id":28220,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63802,"msg_id":28220,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63803,"msg_id":28220,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28220,"thread_id":966,"date":1785593140,"date_sent":1785593140,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35385,"mid":28221,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"OK, so it does look like he turned them away yesterday after speaking to the company on the phone. \n\nThe girl that did the scheduling said that Derek was really against it from the get-go, but then he agreed and then yesterday when the Tech called to say that he was on the way, Derrick said that he was no longer interested in that service, which is a lie, and I don’t understand how he can turn that down.","sub_id":3}}],"addresses":[{"_id":63804,"msg_id":28221,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63805,"msg_id":28221,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63806,"msg_id":28221,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63807,"msg_id":28221,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28221,"thread_id":966,"date":1785593569,"date_sent":1785593569,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35386,"mid":28222,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Not exactly true\nI responded the first time that I would check but\nIt doesn’t matter if you wanted to pay twice or do 2 inspections!\nBut…this is the unfortunate part of dealing w the seller himself instead of going through the scheduling system. ","sub_id":3}}],"addresses":[{"_id":63808,"msg_id":28222,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63809,"msg_id":28222,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63810,"msg_id":28222,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63811,"msg_id":28222,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28222,"thread_id":966,"date":1785594740,"date_sent":1785594740,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":"{\"_id\":35387,\"mid\":28223,\"seq\":0,\"ct\":\"image\\\/png\",\"name\":\"IMG_0060.png\",\"cid\":\"<file_transfer_original>\",\"_data\":\"\\\/data\\\/user_de\\\/0\\\/com.android.providers.telephony\\\/app_parts\\\/PART_1785594762564\",\"sub_id\":3}","filename":"IMG_0060.png"}],"addresses":[{"_id":63812,"msg_id":28223,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63813,"msg_id":28223,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63814,"msg_id":28223,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63815,"msg_id":28223,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28223,"thread_id":966,"date":1785594760,"date_sent":1785594760,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"image\/png","m_type":132,"m_size":917512,"tr_id":"proto:\/xgUS8p6bcOsO9usgyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":0,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35388,"mid":28224,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"What do we do from here cause I really wanna get this Hvac thing done. \n\nI went out of my way to make sure that every scheduled thing was accommodating to him and even went as far as hiring the electrician and hvac to double check they could go out same day and even reconfirmed yesterday. \n\nIt’s starting to get really frustrating. Was he even allowed to deny them?","sub_id":3}}],"addresses":[{"_id":63816,"msg_id":28224,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63817,"msg_id":28224,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63818,"msg_id":28224,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63819,"msg_id":28224,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28224,"thread_id":966,"date":1785595233,"date_sent":1785595233,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35389,"mid":28225,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Also, when I spoke to the electrician yesterday, he even reconfirmed me that they were sending a different person for Hvac. After the electrician got done with his inspection, he even went as far as stating he would confirm with the company that the Hvac guy was still coming that day, but I had told him that I had already confirmed so that he didn’t have to…. \n\nSo when Derrick says that the electrician told him that he was the only one coming out yesterday, I don’t necessarily believe that.  Or he was misinterpreting something.","sub_id":3}}],"addresses":[{"_id":63820,"msg_id":28225,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63821,"msg_id":28225,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63822,"msg_id":28225,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63823,"msg_id":28225,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28225,"thread_id":966,"date":1785595340,"date_sent":1785595340,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35390,"mid":28226,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"He shouldn’t turn them away, he is obviously allowed to deny the time or change a time.\nIt sounds like he is just frustrated w the multiple people\/multiple days but that is part of it.","sub_id":3}}],"addresses":[{"_id":63824,"msg_id":28226,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63825,"msg_id":28226,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63826,"msg_id":28226,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63827,"msg_id":28226,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28226,"thread_id":966,"date":1785596413,"date_sent":1785596413,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35391,"mid":28227,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"That’s why I did everything on the Friday because he said he wasn’t available any other day…. \n\nTrust me, I don’t wanna be dealing with this either lol. \n\nI guess I’m just gonna have them reach back out to him and reschedule.","sub_id":3}}],"addresses":[{"_id":63828,"msg_id":28227,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63829,"msg_id":28227,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63830,"msg_id":28227,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63831,"msg_id":28227,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28227,"thread_id":966,"date":1785596562,"date_sent":1785596562,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35392,"mid":28228,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"I get it! I do\n\nDid the first HVAC ever send you anything?","sub_id":3}}],"addresses":[{"_id":63832,"msg_id":28228,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63833,"msg_id":28228,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63834,"msg_id":28228,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63835,"msg_id":28228,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28228,"thread_id":966,"date":1785596617,"date_sent":1785596617,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35393,"mid":28229,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"The first Hvac company didn’t give us any estimates for repairs or anything other than  sending pictures of a picture (taken on iPad) and stating that the units cooled when he turned the temperature down. \n\nThe Chapman Company was pretty much a scam service. We knew the units were working but we requested cost estimates for repairs found during the general house inspection and then estimated life expectancy left on the units due to them being all within replacement range for age. This could cost ALOT of money if the units need to be replaced. ","sub_id":3}}],"addresses":[{"_id":63836,"msg_id":28229,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63837,"msg_id":28229,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63838,"msg_id":28229,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63839,"msg_id":28229,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28229,"thread_id":966,"date":1785597014,"date_sent":1785597014,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/KwyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35394,"mid":28230,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Thank you, I wrote that down in my notebook but wanted to verify as that is what I told Derrick. He told me Chapman did a whole inspection and then told me what his best friend said about the units bc he was a general contractor 🙄","sub_id":3}}],"addresses":[{"_id":63840,"msg_id":28230,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63841,"msg_id":28230,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63842,"msg_id":28230,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63843,"msg_id":28230,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28230,"thread_id":966,"date":1785597389,"date_sent":1785597389,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35395,"mid":28231,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Chapman did so bad that we were trying to get a refund for them card… lol \n","sub_id":3}}],"addresses":[{"_id":63844,"msg_id":28231,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63845,"msg_id":28231,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63846,"msg_id":28231,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63847,"msg_id":28231,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28231,"thread_id":966,"date":1785597543,"date_sent":1785597543,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HrnvMdQM2rrYyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35396,"mid":28232,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"I have contacted the hope company again and asked them to reach out to Derrick with clear instructions and intent on why they are going out there, what to review, and what we are expecting from them. \n\nHVAC and the sewer line are the only two inspections left needing done. ","sub_id":3}}],"addresses":[{"_id":63848,"msg_id":28232,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63849,"msg_id":28232,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63850,"msg_id":28232,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":63851,"msg_id":28232,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28232,"thread_id":966,"date":1785597638,"date_sent":1785597638,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/0gll1v5DXnVoyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35397,"mid":28233,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Okay, thank you. And sewer is Monday right? Hopefully Hope can go back around same time","sub_id":3}}],"addresses":[{"_id":63852,"msg_id":28233,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":63853,"msg_id":28233,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":63854,"msg_id":28233,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":63855,"msg_id