# Python bytecode and packaging artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Local virtual environments and configuration.
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Test, coverage, and analysis caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local editor and operating-system files.
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Rebuildable reading bundles, PDF packages/previews, media ZIPs, and local
# generation pointers. Publish again from source after a fresh checkout.
# Files already tracked in output/ remain tracked until explicitly removed.
/output/

# Manual editor upload receipts and preserved recovery copies are local state.
# Evidence records, the ID registry, revision history, and originals stay trackable.
/data/manual/uploads/
/data/manual/recovery/

# Interrupted atomic saves, original imports, and extracted-asset writes.
/data/**/.save-*
/output/**/.save-*
/data/originals/manual/.import-*
/data/**/.asset-*

# Active review/editor/publisher locks; saved evidence and results stay trackable.
/data/reviews/.runner.lock
/data/manual/.writer.lock
/output/.publish.lock

# Originals, curated archives, manual evidence/history, and review results are
# authoritative project data and remain trackable. Generated copies live in output/.
