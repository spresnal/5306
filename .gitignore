# Python bytecode and packaging artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Local virtual environments and configuration.
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Test, coverage, and analysis caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local editor and operating-system files.
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Temporary PDF renders/previews at any depth, including published generations.
/output/**/*_pdf_assets/
/output/**/.*_pdf_render.html

# Interrupted output staging files; keep the completed exports and packages.
/output/**/.*-*.html
/output/**/.*-*.pdf
/output/**/.*-*.md
/output/**/.*-*.csv
/output/**/.*-*.zip
/output/**/.*-*.js

# Manual editor upload receipts and preserved recovery copies are local state.
# Evidence records, the ID registry, revision history, and originals stay trackable.
/data/manual/uploads/
/data/manual/recovery/

# Interrupted atomic saves, original imports, and extracted-asset writes.
/data/**/.save-*
/output/**/.save-*
/data/originals/manual/.import-*
/data/**/.asset-*

# Active review/editor/publisher locks; saved evidence and results stay trackable.
/data/reviews/.runner.lock
/data/manual/.writer.lock
/output/.publish.lock

# Originals, curated archives, review backups/results, and final timeline exports
# are intentional project artifacts; keep data/, backups/, and output/ trackable.
