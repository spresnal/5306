not have any of the above ","sub_id":3}}],"addresses":[{"_id":62741,"msg_id":27855,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":62742,"msg_id":27855,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":62743,"msg_id":27855,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":62744,"msg_id":27855,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":27855,"thread_id":966,"date":1784807117,"date_sent":1784807117,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":34889,"mid":27856,"seq":0,"ct":"text\/plain","chset":106,"cid":"<text000001>","cl":"text000001.txt","text":"Ok, thank you. We are contacting the health department now. \n\nOn another note, the earnest money is due today. Is there a link or wire instructions?","sub_id":3}}],"addresses":[{"_id":62745,"msg_id":27856,"address":"+15748508256","type":137,"charset":106,"sub_id":3},{"_id":62746,"msg_id":27856,"address":"+17694289566","type":151,"charset":106,"sub_id":3},{"_id":62747,"msg_id":27856,"address":"+13176504377","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":27856,"thread_id":966,"date":1784810717,"date_sent":0,"msg_box":2,"read":1,"ct_t":"application\/vnd.wap.multipart.related","exp":604800,"m_cls":"personal","m_type":128,"v":18,"m_size":148,"pri":129,"rr":129,"tr_id":"proto:\/HEIw=","ct_cls":135,"d_rpt":129,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":34892,"mid":27858,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Let me know if you got the Earnnest request.\nIt’s easier to pay from a regular checking\/savings account but can be done from a fancier account (money market, investment) but those usually put a short term hold, only a $1 and then the rest and take longer. Just an FYI! \n\nI sent the new BA showing the seller paying commission.\n\nLet me know if the inspector or Sam’s dad finds anything big or crazy today. And send me reports please or have Bill send.\nThanks!","sub_id":3}}],"addresses":[{"_id":62750,"msg_id":27858,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":62751,"msg_id":27858,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":62752,"msg_id":27858,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":62753,"msg_id":27858,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":27858,"thread_id":966,"date":1784811794,"date_sent":1784811794,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":34894,"mid":27859,"seq":0,"ct":"text\/plain","chset":106,"cid":"<text000001>","cl":"text000001.txt","text":"I got the Earnnest request. I will pay from my regular checking account. I still have one linked on there.\n\nCompleted.\n\nWill do!","sub_id":3}}],"addresses":[{"_id":62754,"msg_id":27859,"address":"+15748508256","type":137,"charset":106,"sub_id":3},{"_id":62755,"msg_id":27859,"address":"+17694289566","type":151,"charset":106,"sub_id":3},{"_id":62756,"msg_id":27859,"address":"+13176504377","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":27859,"thread_id":966,"date":1784812286,"date_sent":0,"msg_box":2,"read":1,"ct_t":"application\/vnd.wap.multipart.related","exp":604800,"m_cls":"personal","