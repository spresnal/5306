,"data":{"_id":28461,"thread_id":966,"date":1786112468,"date_sent":1786112468,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35694,"mid":28462,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Oh no… I don’t understand. I’m sorry. \n\nThey had two weeks for their lawyer to explain that to them. We didn’t pull a fast one on them or manipulate them in anyway. \n\nI hope they aren’t malicious and do anything to the house ","sub_id":3}}],"addresses":[{"_id":64544,"msg_id":28462,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":64545,"msg_id":28462,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":64546,"msg_id":28462,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":64547,"msg_id":28462,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28462,"thread_id":966,"date":1786112612,"date_sent":1786112612,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35695,"mid":28463,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"We still haven’t gotten anything… ","sub_id":3}}],"addresses":[{"_id":64548,"msg_id":28463,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":64549,"msg_id":28463,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":64550,"msg_id":28463,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":64551,"msg_id":28463,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipi