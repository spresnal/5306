orrow\nSince you are cash they don’t ask for proof but if you would be insured we wouldn’t be able to close without it\nI guess I would say if you can…get a policy for tomorrow and if you don’t like it you can always change companies. Maybe not w the Chubb lady but someone else","sub_id":3}}],"addresses":[{"_id":64474,"msg_id":28442,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":64475,"msg_id":28442,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":64476,"msg_id":28442,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":64477,"msg_id":28442,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28442,"thread_id":966,"date":1786034232,"date_sent":1786034232,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35671,"mid":28444,"seq":0,"ct":"text\/plain","chset":106,"cid":"<text000001>","cl":"text000001.txt","text":"I was told we shouldn't have a problem having Chubb active by tomorrow. Should have proof of coverage this afternoon","sub_id":3}}],"addresses":[{"_id":64480,"msg_id":28444,"address":"+15748508256","type":137,"charset":106,"sub_id":3},{"_id":64481,"msg_id":28444,"address":"+17694289566","type":151,"charset":106,"sub_id":3},{"_id":64482,"msg_id":28444,"address":"+13176504377","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28444,"thread_id":966,"date":1786039256,"date_sent":0,"msg_box":2,"read":1,"ct_t":"application\/vnd.wap.multipart.related","exp":604800,"m_cls":"personal","m_type":128,"v":18,"m_size":116,"pri":129,"rr":129,"tr_id":"proto:\/vzfzrAcYFyUyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"d_rpt":129,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35675,"mid":28448,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Good morning. Closing day, but kind of anti climatic! :)\nEven though you are e-signing, I am going to their closing to watch them sign. It shouldn’t take too long as the seller doesn’t have a lot to sign.\nI have verified everything is ready, funds have been received by title company. \n\nDerrick wants your email to send you the utility information. You will just need to transfer those for the possession date of 8\/21. So no super duper hurry, but when you have time you can do.\nIs it okay to give Sam’s email?","sub_id":3}}],"addresses":[{"_id":64493,"msg_id":28448,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":64494,"msg_id":28448,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":64495,"msg_id":28448,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":64496,"msg_id":28448,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":28448,"thread_id":966,"date":1786102582,"date_sent":1786102582,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/5Un0rM332f4GAWgyEG7yz57gLkcpi2XGnN\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35677,"mid":28449,"seq":0,"ct":"text\/plain","chset":106,"cid":"<text000001>","cl":"text000001.txt","text":"Glad to hear everything is in order. Yes, you can share my email","sub_id":3}}],"addresses":[{"_id":64497,"msg_id":28449,"address":"+15748508256","type":137,"charset":106,"sub_id":3},{"_id":64498,"msg_id":28449,"address":"+17694289566","type":151,"charset":106,"sub_id":3},{"_id":64499,"msg_id":28449,"address":"+13176504377","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28449,"thread_id":966,"date":1786102747,"date_sent":0,"msg_box":2,"read":1,"ct_t":"application\/vnd.wap.multipart.related","exp":604800,"m_cls":"personal","m_type":128,"v":18,"m_size":64,"pri":129,"rr":129,"tr_id":"proto:\/HEIw=","ct_cls":135,"d_rpt":129,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35679,"mid":28450,"seq":0,"ct":"text\/plain","chset":106,"cid":"<text000001>","cl":"text000001.txt","text":"The insurance agent didn't get proof of coverage over to me yesterday. At EOD yesterday they said it was still pending with Chubb. \"If I don’t have tonight, I will have tomorrow and will get that sent over.\"\n\nSo that's still incomplete..","sub_id":3}}],"addresses":[{"_id":64500,"msg_id":28450,"address":"+15748508256","type":137,"charset":106,"sub_id":3},{"_id":64501,"msg_id":28450,"address":"+17694289566","type":151,"charset":106,"sub_id":3},{"_id":64502,"msg_id":28450,"address":"+13176504377","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":28450,"thread_id":966,"date":1786109276,"date_sent":0,"msg_box":2,"read":1,"ct_t":"application\/vnd.wap.multipart.related","exp":604800,"m_cls":"personal","m_type":128,"v":18,"m_size":239,"pri":129,"rr":129,"tr_id":"proto:\/HEIw=","ct_cls":135,"d_rpt":129,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":35680,"mid":28451,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Okay, again all good for closing. Just follow up again with agent. \nHave you signed docs yet?\nMy 12 year old came with me as my buffer 😂","sub_id":3}}],"addresses":[{"_id":64503,"msg_id":28451,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":64504,"m