76504377","type":130,"charset":106,"sub_id":3},{"_id":62678,"msg_id":27832,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":62679,"msg_id":27832,"address":"+13176504377","type":137,"charset":106,"sub_id":3},{"_id":62680,"msg_id":27832,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+13176504377","recipients":"+17694289566,+13176504377","data":{"_id":27832,"thread_id":966,"date":1784758015,"date_sent":1784758015,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":34861,"mid":27837,"seq":0,"ct":"text\/plain","name":"body","chset":106,"text":"Was not expecting that, wow. I haven’t seen anything about that yet! \n\nAnd yes. \n\nOutdoor furniture \nAnd pool table. \n","sub_id":3}}],"addresses":[{"_id":62692,"msg_id":27837,"address":"+13176504377","type":130,"charset":106,"sub_id":3},{"_id":62693,"msg_id":27837,"address":"+17694289566","type":130,"charset":106,"sub_id":3},{"_id":62694,"msg_id":27837,"address":"+17694289566","type":137,"charset":106,"sub_id":3},{"_id":62695,"msg_id":27837,"address":"+15748508256","type":151,"charset":106,"sub_id":3}],"address":"+17694289566","recipients":"+17694289566,+13176504377","data":{"_id":27837,"thread_id":966,"date":1784758376,"date_sent":1784758376,"msg_box":1,"read":1,"sub":"","sub_cs":106,"ct_t":"text\/plain","m_type":132,"m_size":0,"tr_id":"proto:\/HEIw=","ct_cls":135,"locked":0,"sub_id":3,"seen":1,"creator":"com.google.android.apps.messaging","text_only":1,"restricted":1}},{"type":2,"attachments":[{"data":{"_id":34882,"mid":27851,"seq":0,"ct":"text\/plain","chset":106,"cid":"<text000001>","cl":"text000001.txt","text":"Could you please ask the owners whether they have any septic system drawings or records for the property, such as the original septic permit, site pl